modules = ["nodejs-20", "web", "postgresql-16"]
[nix]
packages = ["unzipNLS", "zulu23", "nano"]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[deployment]
run = ["node", "./dist/index.cjs"]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]

[objectStorage]
defaultBucketID = "replit-objstore-6f67444f-b771-4c8f-bea8-fd3ebf96c798"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3001

[userenv]

[userenv.shared]
GROQ_API_KEY = "dddddgxsgnnvxfcg"
