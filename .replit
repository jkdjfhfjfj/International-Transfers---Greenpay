modules = ["nodejs-24", "python-base-3.13", "java-graalvm22.3"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/greenpay-web: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "greenpay-test-suite"

[[workflows.workflow]]
name = "greenpay-test-suite"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd greenpay && npm run test:all"

[workflows.workflow.metadata]
isValidation = true


[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["jdk17_headless", "cmake", "ninja"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 22920
externalPort = 3001

[[ports]]
localPort = 24678
externalPort = 3000

[userenv]

[userenv.shared]
EXPO_PUBLIC_DOMAIN = "geepay.us"
GREENPAY_PRODUCTION_URL = "https://geepay.us"
