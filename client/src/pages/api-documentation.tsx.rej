     method: '\''POST'\'',
     headers: {
       '\''Authorization'\'': \`Bearer \${API_KEY}\`,
       '\''Content-Type'\'': '\''application/json'\''
     },
     body: JSON.stringify({
       amount,
       currency,
       recipientDetails: { userId: recipientId }
     })
   });
   
   if (!response.ok) {
     throw new Error(\`API Error: \${response.status}\`);
   }
   
   return await response.json();
 }
 
 // Get exchange rate
